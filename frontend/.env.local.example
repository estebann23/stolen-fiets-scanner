# Leave unset in local dev: the browser calls same-origin `/backend`,
# which Next.js rewrites to FastAPI (127.0.0.1:8000).
# Only set this if the API is on another host:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional override for the rewrite target (server-side only):
# API_URL=http://127.0.0.1:8000
